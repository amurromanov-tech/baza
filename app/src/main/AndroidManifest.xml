<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ===== РАЗРЕШЕНИЯ ===== -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 🆕 v21.0.1: полный бэкап (ZIP с фото) в Download/BAZA/full_backup/.
         На Android 11+ (API 30+) без этого разрешения запись в общий Download/
         невозможна. Запрашивается в рантайме через
         Settings.ACTION_MANAGE_APP_ALL_FILES_ACCESS_PERMISSION.
         Только для админа (Алексей) — см. BackupActivity.ensureStoragePermission(). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Восстановление напоминаний после перезагрузки -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 🆕 AlarmManager: точные alarms для напоминаний (Android 12+) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- ============================================================ -->
    <!-- 🆕 v23.4.3: <queries> — видимость установленных приложений  -->
    <!-- Android 11+ (API 30) скрывает установленные приложения,      -->
    <!-- если они явно не перечислены здесь. Без этого                 -->
    <!-- packageManager.getPackageInfo("com.zerotier.one") всегда     -->
    <!-- возвращает NameNotFoundException, даже если ZeroTier         -->
    <!-- реально установлен.                                           -->
    <!-- ============================================================ -->
    <queries>
        <!-- 🆕 v23.4.3: ZeroTier One — для проверки установки и запуска -->
        <package android:name="com.zerotier.one" />

        <!-- Установка APK (обновления) -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>

        <!-- Открытие HTTPS-ссылок (обновления, Google Play) -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>

        <!-- Отправка email (диагностика) -->
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>

        <!-- 🆕 v20.5.14: внешний видеоплеер (для AVI и fallback) -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="video/*" />
        </intent>
    </queries>

    <application
        android:name=".BaseApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BAZA"
        android:usesCleartextTraffic="true"
        android:requestLegacyExternalStorage="true">

        <!-- 🆕 v21.0.10: предзагрузка модуля Google Code Scanner.
             Play Services скачает barcode_ui при установке из Play Store
             (при локальной установке — при первом использовании).
             Если при первом запуске будет CODE_SCANNER_UNAVAILABLE —
             просто подождать несколько секунд и повторить. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- ============================================================ -->
        <!-- RECEIVER: восстановление напоминаний после boot / обновления -->
        <!-- ============================================================ -->
        <receiver
            android:name=".util.BootReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- ============================================================ -->
        <!-- 🆕 RECEIVER: показ напоминания о конкретной задаче          -->
        <!-- ============================================================ -->
        <receiver
            android:name=".util.TaskReminderReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.family.base.action.TASK_REMIND" />
            </intent-filter>
        </receiver>

        <!-- ============================================================ -->
        <!-- ГЛАВНЫЕ ACTIVITIES                                          -->
        <!-- 🆕 v20.4.1: все Activity зафиксированы в портрете,           -->
        <!-- кроме FullscreenImageActivity и сканеров (у сканеров уже был)-->
        <!-- ============================================================ -->
        <activity
            android:name=".ui.LoginActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.MainActivity"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <!-- ===== ВЫБОР ПОЛЬЗОВАТЕЛЯ ===== -->
        <activity
            android:name=".ui.SelectUserActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <activity
            android:name=".ui.BarcodeScannerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <!-- ============================================================ -->
        <!-- ЭКРАНЫ ДОБАВЛЕНИЯ И РЕДАКТИРОВАНИЯ -->
        <!-- ============================================================ -->
        <activity
            android:name=".ui.AddItemActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <activity
            android:name=".ui.ItemDetailActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <activity
            android:name=".ui.ConnectFamilyActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <!-- FullscreenImageActivity — ОСТАВЛЕНА СВОБОДНОЙ (просмотр фото) -->
        <activity
            android:name=".ui.FullscreenImageActivity"
            android:exported="false"
            android:theme="@style/Theme.BAZA.Fullscreen" />

        <!-- ============================================================ -->
        <!-- 🆕 v20.4.9: ГАЛЕРЕЯ «🖼️ Галерея» → /Романовы на Диске -->
        <!-- Портретная ориентация, как у всех, кроме FullscreenImage    -->
        <!-- и сканеров. На каждую подпапку — новый экземпляр Activity,   -->
        <!-- поэтому launchMode НЕ singleTop (иначе стек «Назад» сломается). -->
        <!-- ============================================================ -->
        <activity
            android:name=".ui.GalleryActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <!-- ============================================================ -->
        <!-- 🆕 v20.5.14: ВИДЕОПЛЕЕР (ExoPlayer / Media3)               -->
        <!-- Свободная ориентация — видео удобнее смотреть в ландшафте.   -->
        <!-- configChanges — чтобы поворот не пересоздавал Activity       -->
        <!-- (ExoPlayer продолжает играть без паузы).                    -->
        <!-- ============================================================ -->
        <activity
            android:name=".ui.VideoPlayerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.BAZA.Fullscreen"
            tools:ignore="DiscouragedApi" />

        <!-- ============================================================ -->
        <!-- НАСТРОЙКИ И РАЗДЕЛЫ -->
        <!-- ============================================================ -->
        <activity
            android:name=".ui.SettingsActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <activity
            android:name=".ui.StatsAndAccountingActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <activity
            android:name=".ui.BackupActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <activity
            android:name=".ui.DiagnosticsActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <activity
            android:name=".ui.HistoryActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <activity
            android:name=".ui.AppSettingsActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <!-- О программе -->
        <activity
            android:name=".ui.AboutActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <!-- ============================================================ -->
        <!-- 🆕 v21.1.0: РЕЦЕПТЫ                                         -->
        <!-- ============================================================ -->
        <activity
            android:name=".ui.RecipeListActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <activity
            android:name=".ui.RecipeEditActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <activity
            android:name=".ui.RecipeDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <!-- ============================================================ -->
        <!-- СТАТИСТИКА, АРХИВ, ЗАЙМЫ -->
        <!-- ============================================================ -->
        <activity
            android:name=".ui.StatisticsActivity"
            android:screenOrientation="portrait"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <activity
            android:name=".ui.ArchiveActivity"
            android:screenOrientation="portrait"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <activity
            android:name=".ui.LentItemsActivity"
            android:screenOrientation="portrait"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <!-- Аудит базы -->
        <activity
            android:name=".ui.AuditActivity"
            android:screenOrientation="portrait"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <!-- ============================================================ -->
        <!-- ДОМАШНИЕ ДЕЛА -->
        <!-- ============================================================ -->
        <activity
            android:name=".ui.TaskListActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <!-- ============================================================ -->
        <!-- СПИСОК ПОКУПОК -->
        <!-- ============================================================ -->
        <activity
            android:name=".ui.ShoppingListActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <!-- ============================================================ -->
        <!-- 🆕 ЧЕКИ ЧЕРЕЗ proverkacheka.com (QR → API)                  -->
        <!-- ============================================================ -->
        <activity
            android:name=".ui.ReceiptPreviewActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <!-- ============================================================ -->
        <!-- OAUTH REDIRECT -->
        <!-- ============================================================ -->
        <activity
            android:name="net.openid.appauth.RedirectUriReceiverActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="com.family.base"
                    android:host="oauth2redirect" />
            </intent-filter>
        </activity>

    </application>
</manifest>
