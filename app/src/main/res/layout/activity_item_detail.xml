<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
        app:elevation="4dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsingToolbar"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:contentScrim="?attr/colorPrimary"
            app:expandedTitleMarginStart="16dp"
            app:expandedTitleMarginBottom="16dp"
            app:collapsedTitleTextAppearance="?attr/textAppearanceHeadline6">

            <ImageView
                android:id="@+id/ivPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Фото предмета"
                app:layout_collapseMode="parallax" />

            <ImageView
                android:id="@+id/ivPhotoPlaceholder"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_item_default"
                android:alpha="0.4"
                android:contentDescription="Нет фото"
                app:layout_collapseMode="parallax" />

            <View
                android:id="@+id/photoOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#66000000"
                android:visibility="gone"
                app:layout_collapseMode="pin" />

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:layout_collapseMode="pin"
                app:navigationIcon="@android:drawable/ic_menu_close_clear_cancel"
                app:navigationContentDescription="Назад" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:padding="16dp"
                android:text="Детали предмета"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"
                android:shadowColor="#000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="4"
                app:layout_collapseMode="parallax" />
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ===== ЧИПЫ-СТАТУСЫ ===== -->
            <LinearLayout
                android:id="@+id/chipGroupStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="start|center_vertical"
                android:layout_marginBottom="4dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipType"
                    style="@style/PastelChip.Thing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📦 Предмет"
                    android:visibility="gone" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipExpired"
                    style="@style/PastelChip.Expired"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="⏰ Просрочен"
                    android:visibility="gone" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSoon"
                    style="@style/PastelChip.Soon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="⚠️ Скоро"
                    android:visibility="gone" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipLent"
                    style="@style/PastelChip.Lent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="🤝 Выдан"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- ===== МЕСТОНАХОЖДЕНИЕ ===== -->
            <TextView
                style="@style/SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 Местонахождение" />

            <com.google.android.material.card.MaterialCardView
                style="@style/SectionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvItemPath"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/pathTextColor"
                        android:lineSpacingExtra="4dp"
                        tools:text="📂 Корень / Продукты / Чай" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGoToFolder"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Перейти в папку →"
                        android:textColor="@color/colorPrimary"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== ОСНОВНОЕ ===== -->
            <TextView
                style="@style/SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📦 Основное" />

            <com.google.android.material.card.MaterialCardView
                style="@style/SectionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Название: чип (view) -->
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipNameView"
                        style="@style/FieldChip.Name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="📝 Чай Greenfield" />

                    <!-- Название: TextInput (edit) -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Название"
                        app:boxBackgroundMode="outline"
                        android:visibility="gone">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Количество: чип (view) -->
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipQuantityView"
                        style="@style/FieldChip.Quantity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        tools:text="📦 ×3" />

                    <!-- Количество: edit-блок -->
                    <LinearLayout
                        android:id="@+id/quantityEditBlock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp"
                        android:visibility="gone">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnMinus"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:text="−"
                            android:textSize="20sp"
                            android:padding="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            app:cornerRadius="12dp"
                            android:backgroundTint="#607D8B" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp"
                            android:hint="Количество"
                            app:boxBackgroundMode="outline">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etQuantity"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:gravity="center" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPlus"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:text="+"
                            android:textSize="20sp"
                            android:padding="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            app:cornerRadius="12dp"
                            android:backgroundTint="#4CAF50" />
                    </LinearLayout>

                    <!-- Тип: RadioGroup (edit) -->
                    <LinearLayout
                        android:id="@+id/typeEditBlock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="12dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Тип"
                            android:textSize="14sp"
                            android:layout_marginBottom="4dp" />

                        <RadioGroup
                            android:id="@+id/rgTypeEdit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <RadioButton
                                android:id="@+id/rbTypeFood"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Еда" />

                            <RadioButton
                                android:id="@+id/rbTypeMedicine"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Лекарство" />

                            <RadioButton
                                android:id="@+id/rbTypeThing"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Предмет" />

                            <RadioButton
                                android:id="@+id/rbTypeOther"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Другое" />
                        </RadioGroup>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== ДЕТАЛИ ===== -->
            <TextView
                style="@style/SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔖 Детали" />

            <com.google.android.material.card.MaterialCardView
                style="@style/SectionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Штрих-код: чип (view) -->
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipBarcodeView"
                        style="@style/FieldChip.Barcode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="🔢 4601234567890" />

                    <!-- Штрих-код: edit-блок -->
                    <LinearLayout
                        android:id="@+id/barcodeEditBlock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:visibility="gone">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilBarcode"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Штрих-код"
                            app:boxBackgroundMode="outline">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etBarcode"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnScanBarcode"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_marginStart="8dp"
                            android:text="📷"
                            android:textSize="20sp"
                            android:padding="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            app:cornerRadius="12dp"
                            android:backgroundTint="#2196F3" />
                    </LinearLayout>

                    <!-- Срок годности: чип (view) -->
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipExpiryView"
                        style="@style/FieldChip.Expiry"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        tools:text="⏰ до 15.12.2026" />

                    <!-- Срок годности: TextInput (edit) -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilExpiry"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="Срок годности (дд.мм.гггг)"
                        app:boxBackgroundMode="outline"
                        android:visibility="gone">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etExpiry"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusable="false"
                            android:clickable="true" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Цена: чип (view) -->
                    <com.google.android.material.chip.Chip
                        android:id="@+id/tvPrice"
                        style="@style/PriceChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:visibility="gone"
                        tools:text="💰 100 ₽"
                        tools:visibility="visible" />

                    <!-- Цена: TextInput (edit) -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilPrice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="Цена (₽)"
                        app:boxBackgroundMode="outline"
                        android:visibility="gone">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPrice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== ДАТЫ ===== -->
            <TextView
                android:id="@+id/tvDatesTitle"
                style="@style/SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📅 Даты" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDates"
                style="@style/SectionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/DateLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Добавлено" />
                    <TextView
                        android:id="@+id/tvDateAdded"
                        style="@style/DateValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="01.10.2026" />

                    <TextView
                        style="@style/DateLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Последнее изменение" />
                    <TextView
                        android:id="@+id/tvDateModified"
                        style="@style/DateValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="05.10.2026" />

                    <TextView
                        android:id="@+id/tvDateExpiryLabel"
                        style="@style/DateLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Срок годности"
                        android:visibility="gone" />
                    <TextView
                        android:id="@+id/tvDateExpiry"
                        style="@style/DateValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        tools:text="15.12.2026" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== ОПИСАНИЕ ===== -->
            <TextView
                android:id="@+id/tvDescriptionTitle"
                style="@style/SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📝 Описание" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDescription"
                style="@style/SectionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvDescriptionView"
                        style="@style/DescriptionText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="Чёрный чай Greenfield в пакетиках." />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Описание"
                        app:boxBackgroundMode="outline"
                        android:visibility="gone">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minLines="3"
                            android:gravity="top|start"
                            android:inputType="textMultiLine" />
                    </com.google.android.material.textfield.TextInputLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== ЗАЙМ ===== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLentInfo"
                style="@style/SectionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFF3E0"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvLentTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🤝 Выдан"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#E65100" />

                    <TextView
                        android:id="@+id/tvLentPerson"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="#424242"
                        android:layout_marginTop="4dp"
                        tools:text="Кому: Иванов" />

                    <TextView
                        android:id="@+id/tvLentDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="#424242"
                        android:layout_marginTop="2dp"
                        tools:text="Дата: 01.10.2026" />

                    <TextView
                        android:id="@+id/tvLentNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="#424242"
                        android:layout_marginTop="2dp"
                        android:visibility="gone"
                        tools:text="Заметка: на неделю" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnReturnItem"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="↩️ Вернуть в базу"
                        android:layout_marginTop="12dp"
                        android:backgroundTint="#4CAF50"
                        android:textColor="@android:color/white"
                        app:cornerRadius="12dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== КНОПКИ РЕЖИМА РЕДАКТИРОВАНИЯ ===== -->
            <LinearLayout
                android:id="@+id/editButtonsLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelEdit"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="Отмена" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSave"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="💾 Сохранить"
                    android:backgroundTint="#4CAF50"
                    android:textColor="@android:color/white"
                    app:cornerRadius="12dp" />
            </LinearLayout>

            <!-- ===== ДОБАВИТЬ ФОТО ===== -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddPhoto"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="📷 Добавить фото"
                android:visibility="gone" />

            <!-- ===== ДЕЙСТВИЯ ===== -->
            <TextView
                android:id="@+id/tvActionsTitle"
                style="@style/SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙️ Действия" />

            <!-- Ряд 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnActionEdit"
                        style="@style/RoundActionButton.Edit"
                        android:text="✏️" />
                    <TextView
                        style="@style/RoundActionLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Изменить" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnActionLend"
                        style="@style/RoundActionButton.Lend"
                        android:text="🤝" />
                    <TextView
                        style="@style/RoundActionLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Выдать" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnActionMove"
                        style="@style/RoundActionButton.Move"
                        android:text="📁" />
                    <TextView
                        style="@style/RoundActionLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Перенести" />
                </LinearLayout>
            </LinearLayout>

            <!-- Ряд 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnActionCopy"
                        style="@style/RoundActionButton.Copy"
                        android:text="📋" />
                    <TextView
                        style="@style/RoundActionLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Копировать" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnActionArchive"
                        style="@style/RoundActionButton.Archive"
                        android:text="📦" />
                    <TextView
                        style="@style/RoundActionLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="В архив" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnActionDelete"
                        style="@style/RoundActionButton.Delete"
                        android:text="🗑" />
                    <TextView
                        style="@style/RoundActionLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Удалить" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
