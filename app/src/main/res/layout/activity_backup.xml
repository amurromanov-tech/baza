<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ============================================================ -->
        <!-- ВЕРХНЯЯ ПАНЕЛЬ -->
        <!-- ============================================================ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="← Назад"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="💾 Резервное копирование"
                android:textAppearance="?attr/textAppearanceHeadline6"
                android:gravity="center" />
        </LinearLayout>

        <!-- ============================================================ -->
        <!-- БЛОК 1: ОБЫЧНЫЙ БЭКАП (JSON) — как раньше -->
        <!-- ============================================================ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Обычный бэкап (JSON)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExportLocal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📤 Экспорт локальный"
            android:backgroundTint="#EFEBE6"
            android:textColor="#424242"
            app:cornerRadius="12dp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExportCloud"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="☁️ Экспорт в облако"
            android:backgroundTint="#EFEBE6"
            android:textColor="#424242"
            app:cornerRadius="12dp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnImportLocal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📥 Импорт из локального (JSON)"
            android:backgroundTint="#EFEBE6"
            android:textColor="#424242"
            app:cornerRadius="12dp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnImportCloud"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="☁️ Импорт из облака"
            android:backgroundTint="#EFEBE6"
            android:textColor="#424242"
            app:cornerRadius="12dp"
            android:layout_marginBottom="24dp" />

        <!-- ============================================================ -->
        <!-- РАЗДЕЛИТЕЛЬ -->
        <!-- ============================================================ -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider"
            android:layout_marginBottom="16dp" />

        <!-- ============================================================ -->
        <!-- 🆕 v21.0.1: БЛОК 2: ПОЛНЫЙ БЭКАП (ZIP с фото) -->
        <!-- Виден только Алексею.                                     -->
        <!-- 🆕 v21.0.2: Сворачиваемый — по умолчанию кнопки скрыты.   -->
        <!-- ============================================================ -->
        <LinearLayout
            android:id="@+id/llFullBackupBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:background="#FFF3E0"
            android:padding="12dp"
            android:layout_marginBottom="16dp">

            <!-- Заголовок-переключатель: жми, чтобы раскрыть/свернуть кнопки -->
            <LinearLayout
                android:id="@+id/llFullBackupHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⚠️ Полный бэкап (с фото)"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#E65100" />

                <TextView
                    android:id="@+id/tvFullBackupChevron"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▼"
                    android:textSize="14sp"
                    android:textColor="#E65100"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ZIP-архив: предметы, папки, задачи, история, настройки и все фотографии. Галерея и логи не включаются. Доступно только Алексею."
                android:textSize="12sp"
                android:textColor="#5D4037"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp" />

            <!-- Контейнер с кнопками: скрыт по умолчанию -->
            <LinearLayout
                android:id="@+id/llFullBackupButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFullBackupExport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="💾 Полный бэкап (с фото)"
                    android:backgroundTint="#FFB74D"
                    android:textColor="#000000"
                    app:cornerRadius="12dp"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFullBackupImport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📥 Восстановить из полного бэкапа"
                    android:backgroundTint="#EF9A9A"
                    android:textColor="#000000"
                    app:cornerRadius="12dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============================================================ -->
        <!-- НИЖНИЙ ОТСТУП -->
        <!-- ============================================================ -->
        <View
            android:layout_width="match_parent"
            android:layout_height="16dp" />

    </LinearLayout>
</ScrollView>
