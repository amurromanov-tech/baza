<?xml version="1.0" encoding="utf-8"?>
<!--
  🆕 v20.4.9: карточка одного элемента галереи.

  Квадратная ячейка (1:1). Внутри — ImageView на всю ячейку,
  поверх снизу — полупрозрачная плашка с именем файла.

  Состояния ImageView (управляются GalleryAdapter):
   - фото:      Coil грузит preview с Диска (300x300);
   - папка:     иконка ic_folder_default + счётчик не нужен;
   - видео:     иконка ic_video_placeholder (▶️) — в Шаге 1 не открывается;
   - ошибка:    иконка ic_item_default.

  M2-атрибуты (Theme.BAZA — Material 2).
-->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="2dp"
    app:cardCornerRadius="6dp"
    app:cardElevation="1dp"
    app:cardUseCompatPadding="false"
    app:cardPreventCornerOverlap="true"
    app:cardBackgroundColor="?android:attr/colorBackground">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Квадратная миниатюра 1:1 -->
        <ImageView
            android:id="@+id/ivThumb"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            android:background="?android:attr/colorBackground"
            android:contentDescription="@string/gallery_thumb_desc"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:src="@drawable/ic_item_default" />

        <!-- Плашка с именем снизу -->
        <TextView
            android:id="@+id/tvName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="#99000000"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textColor="@android:color/white"
            android:textSize="11sp"
            android:maxLines="2"
            android:ellipsize="end"
            app:layout_constraintBottom_toBottomOf="@id/ivThumb"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="IMG_1234.jpg" />

        <!-- Бейдж «▶️» для видео (правый верхний угол) -->
        <TextView
            android:id="@+id/tvVideoBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:background="#99000000"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="@string/gallery_video_badge"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="@id/ivThumb"
            app:layout_constraintEnd_toEndOf="@id/ivThumb"
            tools:visibility="visible" />

        <!-- Бейдж папки (правый верхний угол) -->
        <TextView
            android:id="@+id/tvFolderBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:background="#99000000"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="@string/gallery_folder_badge"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="@id/ivThumb"
            app:layout_constraintEnd_toEndOf="@id/ivThumb"
            tools:visibility="visible" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
