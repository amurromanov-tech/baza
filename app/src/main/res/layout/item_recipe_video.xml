<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="160dp"
    android:layout_height="120dp"
    android:layout_marginEnd="8dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="1dp"
    app:cardUseCompatPadding="false">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Превью: первый кадр или заглушка -->
        <ImageView
            android:id="@+id/ivVideoThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?android:attr/colorBackground"
            android:contentDescription="Видео рецепта"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_item_default" />

        <!-- Иконка play поверх превью -->
        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:background="#66000000"
            android:contentDescription="Воспроизвести"
            android:padding="12dp"
            android:src="@android:drawable/ic_media_play"
            android:tint="#FFFFFF" />

        <!-- Бейдж 🎬 в углу -->
        <TextView
            android:id="@+id/tvVideoBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="4dp"
            android:background="#99000000"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="🎬"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

    </FrameLayout>

</androidx.cardview.widget.CardView>
