<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="8dp">

    <!-- Превью: фото или первый кадр видео -->
    <ImageView
        android:id="@+id/ivThumb"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:background="?android:attr/colorBackground"
        android:contentDescription="Медиа рецепта"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_item_default" />

    <!-- Бейдж типа: 🎬 для видео (для фото скрыт) -->
    <TextView
        android:id="@+id/tvTypeBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="4dp"
        android:background="#99000000"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:text="🎬"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Крестик удаления -->
    <ImageButton
        android:id="@+id/btnRemove"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="top|end"
        android:layout_margin="4dp"
        android:background="@drawable/btn_dark_circle"
        android:contentDescription="Удалить медиа"
        android:padding="4dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:tint="#FFFFFF" />

</FrameLayout>
