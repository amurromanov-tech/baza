<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ============================================================ -->
        <!-- ВЕРХНЯЯ ПАНЕЛЬ: НАЗАД + ЗАГОЛОВОК -->
        <!-- ============================================================ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="← Назад"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📊 Статистика и учёт"
                android:textAppearance="?attr/textAppearanceHeadline6"
                android:gravity="center" />
        </LinearLayout>

        <!-- ============================================================ -->
        <!-- СЕКЦИЯ: СТАТИСТИКА -->
        <!-- ============================================================ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="СТАТИСТИКА"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@android:color/darker_gray"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnStatistics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📊 Статистика расходов" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Расходы по категориям, итого в базе, выдано, архив"
            android:textSize="12sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginBottom="24dp" />

        <!-- ============================================================ -->
        <!-- СЕКЦИЯ: АРХИВ -->
        <!-- ============================================================ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="АРХИВ"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@android:color/darker_gray"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnArchive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📦 Архив предметов" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Предметы, которые были съедены, сломаны, подарены или выброшены"
            android:textSize="12sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginBottom="24dp" />

        <!-- ============================================================ -->
        <!-- СЕКЦИЯ: ЗАЙМЫ -->
        <!-- ============================================================ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ЗАЙМЫ"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@android:color/darker_gray"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnLentItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🤝 Выданные предметы" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Предметы, которые вы кому-то одолжили"
            android:textSize="12sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginBottom="24dp" />

        <!-- ============================================================ -->
        <!-- СЕКЦИЯ: АУДИТ БАЗЫ -->
        <!-- ============================================================ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="АУДИТ БАЗЫ"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@android:color/darker_gray"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnAudit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔍 Аудит базы" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Проверка заполненности данных: без цены, без срока годности, без штрих-кода и другое"
            android:textSize="12sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginBottom="24dp" />

        <!-- Отступ снизу -->
        <View
            android:layout_width="match_parent"
            android:layout_height="16dp" />

    </LinearLayout>
</ScrollView>
