<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ============================================================ -->
        <!-- ВЕРХНЯЯ ПАНЕЛЬ -->
        <!-- ============================================================ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="← Назад"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⚙️ Настройки"
                android:textAppearance="?attr/textAppearanceHeadline6"
                android:gravity="center" />
        </LinearLayout>

        <!-- ============================================================ -->
        <!-- ГЛАВНОЕ ДЕЙСТВИЕ: СИНХРОНИЗАЦИЯ -->
        <!-- ============================================================ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSyncNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔄 Синхронизировать сейчас"
            app:cornerRadius="12dp"
            android:layout_marginBottom="16dp" />

        <!-- ============================================================ -->
        <!-- РАЗДЕЛИТЕЛЬ -->
        <!-- ============================================================ -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider"
            android:layout_marginBottom="16dp" />

        <!-- ============================================================ -->
        <!-- РАЗДЕЛЫ -->
        <!-- ============================================================ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShareLink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔗 Поделиться ссылкой на папку"
            android:backgroundTint="#EFEBE6"
            android:textColor="#424242"
            app:cornerRadius="12dp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStatsAndAccounting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📊 Статистика и учёт"
            android:backgroundTint="#EFEBE6"
            android:textColor="#424242"
            app:cornerRadius="12dp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💾 Резервное копирование"
            android:backgroundTint="#EFEBE6"
            android:textColor="#424242"
            app:cornerRadius="12dp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDiagnostics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔍 Диагностика"
            android:backgroundTint="#EFEBE6"
            android:textColor="#424242"
            app:cornerRadius="12dp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAppSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚙️ Настройки приложения"
            android:backgroundTint="#EFEBE6"
            android:textColor="#424242"
            app:cornerRadius="12dp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAbout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ℹ️ О программе"
            android:backgroundTint="#EFEBE6"
            android:textColor="#424242"
            app:cornerRadius="12dp"
            android:layout_marginBottom="4dp" />

        <!-- Подсказка под кнопкой «О программе» -->
        <TextView
            android:id="@+id/tvAboutSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Версия, разработчик, обновление"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- ============================================================ -->
        <!-- НИЖНИЙ ОТСТУП -->
        <!-- ============================================================ -->
        <View
            android:layout_width="match_parent"
            android:layout_height="16dp" />

    </LinearLayout>
</ScrollView>
