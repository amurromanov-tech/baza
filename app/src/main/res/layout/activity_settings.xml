<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ============================================================ -->
        <!-- ВЕРХНЯЯ ПАНЕЛЬ -->
        <!-- ============================================================ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="← Назад"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⚙️ Настройки"
                android:textAppearance="?attr/textAppearanceHeadline6"
                android:gravity="center" />
        </LinearLayout>

        <!-- ============================================================ -->
        <!-- СИНХРОНИЗАЦИЯ -->
        <!-- ============================================================ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSyncNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔄 Синхронизировать сейчас"
            android:backgroundTint="#EFEBE6"
            android:textColor="#424242"
            app:cornerRadius="12dp"
            android:layout_marginBottom="8dp" />

        <!-- ============================================================ -->
        <!-- РАЗДЕЛЫ -->
        <!-- ============================================================ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShareLink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔗 Поделиться ссылкой на папку"
            android:backgroundTint="#EFEBE6"
            android:textColor="#424242"
            app:cornerRadius="12dp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStatsAndAccounting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📊 Статистика и учёт"
            android:backgroundTint="#EFEBE6"
            android:textColor="#424242"
            app:cornerRadius="12dp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💾 Резервное копирование"
            android:backgroundTint="#EFEBE6"
            android:textColor="#424242"
            app:cornerRadius="12dp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDiagnostics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔍 Диагностика"
            android:backgroundTint="#EFEBE6"
            android:textColor="#424242"
            app:cornerRadius="12dp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAppSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚙️ Настройки приложения"
            android:backgroundTint="#EFEBE6"
            android:textColor="#424242"
            app:cornerRadius="12dp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAbout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ℹ️ О программе"
            android:backgroundTint="#EFEBE6"
            android:textColor="#424242"
            app:cornerRadius="12dp"
            android:layout_marginBottom="4dp" />

        <!-- Подсказка под кнопкой «О программе» -->
        <TextView
            android:id="@+id/tvAboutSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Версия, разработчик, обновление"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- ============================================================ -->
        <!-- 🆕 v21.0.1: «ВНИМАНИЕ» + ПОЛНЫЙ БЭКАП (ТОЛЬКО ДЛЯ АЛЕКСЕЯ) -->
        <!-- ============================================================ -->
        <!-- Блок виден всем, но кнопки внутри — только Алексею.        -->
        <!-- Для Римы/Димы блок целиком скрывается в SettingsActivity   -->
        <!-- (visibility = GONE на llAdminWarningBlock).                -->
        <LinearLayout
            android:id="@+id/llAdminWarningBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            android:background="#FFF3E0"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚠️ Внимание"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#E65100"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Полный бэкап включает ВСЕ предметы, папки, задачи, историю и фотографии. Импорт полностью перезаписывает локальные данные. Доступно только Алексею."
                android:textSize="13sp"
                android:textColor="#5D4037"
                android:layout_marginBottom="12dp" />

            <!-- 🆕 Кнопка 1: Полный бэкап -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFullBackupExport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💾 Полный бэкап (с фото)"
                android:backgroundTint="#FFB74D"
                android:textColor="#000000"
                app:cornerRadius="12dp"
                android:layout_marginBottom="8dp" />

            <!-- 🆕 Кнопка 2: Восстановить из полного бэкапа -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFullBackupImport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📥 Восстановить из полного бэкапа"
                android:backgroundTint="#EF9A9A"
                android:textColor="#000000"
                app:cornerRadius="12dp" />
        </LinearLayout>

        <!-- ============================================================ -->
        <!-- НИЖНИЙ ОТСТУП -->
        <!-- ============================================================ -->
        <View
            android:layout_width="match_parent"
            android:layout_height="16dp" />

    </LinearLayout>
</ScrollView>
