<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ============================================================ -->
        <!-- СЕКЦИЯ 1: СИНХРОНИЗАЦИЯ -->
        <!-- ============================================================ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="СИНХРОНИЗАЦИЯ"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@android:color/darker_gray"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnSyncNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔄 Синхронизировать сейчас" />

        <!-- ============================================================ -->
        <!-- СЕКЦИЯ 2: ОБЩАЯ ПАПКА -->
        <!-- ============================================================ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ОБЩАЯ ПАПКА"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@android:color/darker_gray"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnShareLink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔗 Поделиться ссылкой" />

        <!-- ============================================================ -->
        <!-- СЕКЦИЯ 3: СТАТИСТИКА -->
        <!-- ============================================================ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="СТАТИСТИКА"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@android:color/darker_gray"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnStatistics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📊 Статистика расходов" />

        <!-- ============================================================ -->
        <!-- СЕКЦИЯ 4: РЕЗЕРВНОЕ КОПИРОВАНИЕ -->
        <!-- ============================================================ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="РЕЗЕРВНОЕ КОПИРОВАНИЕ"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@android:color/darker_gray"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnExportLocal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📤 Экспорт локально" />

        <Button
            android:id="@+id/btnExportCloud"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="☁️ Экспорт в облако" />

        <Button
            android:id="@+id/btnImportLocal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📥 Импорт из локального" />

        <Button
            android:id="@+id/btnImportCloud"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="☁️ Импорт из облака" />

        <!-- ============================================================ -->
        <!-- СЕКЦИЯ 5: ЛОГИ И ДИАГНОСТИКА -->
        <!-- ============================================================ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ЛОГИ И ДИАГНОСТИКА"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@android:color/darker_gray"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchLogging"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Вести логи" />

        <Button
            android:id="@+id/btnClearLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🗑 Очистить логи" />

        <Button
            android:id="@+id/btnSendLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📩 Отправить логи" />

        <!-- ============================================================ -->
        <!-- СЕКЦИЯ 6: ОБНОВЛЕНИЯ -->
        <!-- ============================================================ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ОБНОВЛЕНИЯ"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@android:color/darker_gray"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnCheckUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔍 Проверить обновления" />

        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Версия 1.0.0"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:gravity="center" />

        <!-- ============================================================ -->
        <!-- СЕКЦИЯ 7: ОПАСНАЯ ЗОНА (СВЁРНУТА) -->
        <!-- ============================================================ -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFEBEE">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Заголовок (кликабельный) -->
                <LinearLayout
                    android:id="@+id/dangerZoneHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="⚠️ ОПАСНАЯ ЗОНА"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#D32F2F" />

                    <TextView
                        android:id="@+id/dangerZoneArrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▼"
                        android:textSize="18sp"
                        android:textColor="#D32F2F" />
                </LinearLayout>

                <!-- Содержимое (скрыто по умолчанию) -->
                <LinearLayout
                    android:id="@+id/dangerZoneContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:paddingTop="0dp"
                    android:visibility="gone">

                    <Button
                        android:id="@+id/btnClearCache"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🧹 Очистить кэш" />

                    <Button
                        android:id="@+id/btnClearAllData"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="⚠️ Полная очистка данных"
                        android:backgroundTint="#D32F2F"
                        android:textColor="@android:color/white" />

                    <Button
                        android:id="@+id/btnLogout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🚪 Выход"
                        android:layout_marginTop="8dp"
                        android:backgroundTint="#D32F2F"
                        android:textColor="@android:color/white" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Отступ снизу -->
        <View
            android:layout_width="match_parent"
            android:layout_height="16dp" />

    </LinearLayout>
</ScrollView>
