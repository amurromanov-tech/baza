<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Уведомления -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Уведомления о сроке годности"
            android:textAppearance="?attr/textAppearanceHeadline6"
            android:layout_marginBottom="8dp" />

        <Switch
            android:id="@+id/switchNotifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Включить уведомления" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Дней до просрочки"
            android:layout_marginTop="8dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDaysBefore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:text="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Час уведомления (0-23)">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNotificationHour"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:text="9" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
    android:id="@+id/btnCheckUpdate"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Проверить обновления"
    android:layout_marginTop="16dp" />

<TextView
    android:id="@+id/tvVersion"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Версия: 1.1.0"
    android:layout_marginTop="8dp" />
        
        <Button
            android:id="@+id/btnSaveNotifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Сохранить настройки уведомлений"
            android:layout_marginTop="8dp" />

        <!-- Разделитель -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorControlHighlight"
            android:layout_marginVertical="16dp" />

        <!-- Синхронизация -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Синхронизация"
            android:textAppearance="?attr/textAppearanceHeadline6"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnSyncNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Синхронизировать сейчас" />

        <!-- Разделитель -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorControlHighlight"
            android:layout_marginVertical="16dp" />

        <!-- Логирование -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Логирование"
            android:textAppearance="?attr/textAppearanceHeadline6"
            android:layout_marginBottom="8dp" />

        <Switch
            android:id="@+id/switchLogging"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Включить логирование"
            android:checked="true" />

        <Button
            android:id="@+id/btnClearLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Очистить логи"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnSendLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Отправить логи разработчику"
            android:layout_marginTop="8dp" />

        <!-- Разделитель -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorControlHighlight"
            android:layout_marginVertical="16dp" />

        <!-- Хранилище -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Хранилище"
            android:textAppearance="?attr/textAppearanceHeadline6"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnClearCache"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Очистить кэш изображений" />

        <!-- Разделитель -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorControlHighlight"
            android:layout_marginVertical="16dp" />

        <!-- О программе -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="О программе"
            android:textAppearance="?attr/textAppearanceHeadline6"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="БАЗА v1.0\nСемейный каталог"
            android:layout_marginBottom="8dp" />


    <!-- ===== ОЧИСТКА ДАННЫХ ===== -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorControlHighlight"
            android:layout_marginVertical="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Очистка данных"
            android:textAppearance="?attr/textAppearanceHeadline6"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnClearAllData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Полная очистка БД + Яндекс.Диск"
            android:backgroundTint="#D32F2F"
            android:layout_marginBottom="16dp" />
        

        

        <!-- Выход -->
        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Выйти"
            android:layout_marginTop="16dp"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

    </LinearLayout>
</ScrollView>
