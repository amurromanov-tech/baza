<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <!-- Вкл/выкл напоминаний -->
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchRemindersEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Напоминать о задачах"
            android:textSize="15sp"
            android:checked="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Раз в сутки присылать сводку задач с дедлайном."
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp" />

        <!-- Час проверки -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Во сколько проверять"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textHour"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="09:00"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="15sp"
                tools:text="09:00" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickHour"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="🕘 Изменить" />
        </LinearLayout>

        <!-- За сколько дней предупреждать -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="За сколько предупреждать"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupDaysBefore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:chipSpacingHorizontal="6dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDays0"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="В день дедлайна" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDays1"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="За 1 день" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDays3"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="За 3 дня" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDays7"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="За 7 дней" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Подсказка -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Проверка выполняется раз в сутки в указанное время и при открытии приложения. Задачи без дедлайна не напоминаются."
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
