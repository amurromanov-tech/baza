<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- ============================================================ -->
    <!-- ВЕРХНЯЯ ПАНЕЛЬ: НАЗАД + ЗАГОЛОВОК -->
    <!-- ============================================================ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Назад"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🤝 Выданные предметы"
            android:textAppearance="?attr/textAppearanceHeadline6"
            android:gravity="center" />
    </LinearLayout>

    <!-- ============================================================ -->
    <!-- ФИЛЬТР ПО ЧЕЛОВЕКУ -->
    <!-- ============================================================ -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Кому выдано:"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorSecondary"
        android:layout_marginBottom="4dp" />

    <Spinner
        android:id="@+id/spinnerPerson"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp" />

    <!-- ============================================================ -->
    <!-- СПИСОК ВЫДАННЫХ ПРЕДМЕТОВ -->
    <!-- ============================================================ -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvLent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

    <!-- ============================================================ -->
    <!-- ИТОГО -->
    <!-- ============================================================ -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#FFF3E0">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvLentTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Итого выдано: 0 ₽"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#E65100"
                android:gravity="center"
                tools:text="Итого выдано: 1540 ₽" />

            <TextView
                android:id="@+id/tvLentCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Предметов: 0"
                android:textSize="14sp"
                android:textColor="#757575"
                android:gravity="center"
                android:layout_marginTop="4dp"
                tools:text="Предметов: 3" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
