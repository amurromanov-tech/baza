<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <!-- Название товара + бейдж «🔄 из истории» -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Название товара"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="15sp"
            tools:text="Хлопья чили 30 гр" />

        <!-- 🆕 Бейдж: найден эталон в истории (скрыт, если совпадений нет) -->
        <TextView
            android:id="@+id/tvMatchBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="🔄 из истории"
            android:textColor="?attr/colorAccent"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="🔄 из истории"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- Цена × количество = сумма -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvPriceQuantity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0.00 ₽ × 1"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp"
            tools:text="80.00 ₽ × 1" />

        <TextView
            android:id="@+id/tvSum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0.00 ₽"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="80.00 ₽" />
    </LinearLayout>

    <!-- Разделитель -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="?android:attr/listDivider" />

</LinearLayout>
