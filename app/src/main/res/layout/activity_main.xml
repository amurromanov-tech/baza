<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorPrimary"
            android:theme="@style/ThemeOverlay.MaterialComponents.Toolbar.Primary"
            tools:title="BAZA">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="end"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/ivSyncStatus"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_sync_done"
                    android:contentDescription="Sync status"
                    android:layout_marginEnd="8dp"
                    android:visibility="visible" />

                <ImageButton
                    android:id="@+id/btnScanSearch"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_scan"
                    android:background="@drawable/btn_dark_circle"
                    android:contentDescription="Сканировать код"
                    android:tint="?attr/colorControlNormal" />

                <ImageButton
                    android:id="@+id/btnSearch"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_search"
                    android:background="@drawable/btn_dark_circle"
                    android:contentDescription="Search"
                    android:tint="?attr/colorControlNormal" />

                <ImageButton
                    android:id="@+id/btnSettings"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_settings"
                    android:background="@drawable/btn_dark_circle"
                    android:contentDescription="Settings"
                    android:tint="?attr/colorControlNormal" />
            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCatalog"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            tools:listitem="@layout/item_catalog_entry" />

        <!-- Нижняя панель -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="8dp"
            android:background="?attr/colorSurface">

            <ImageButton
                android:id="@+id/btnAddFolder"
                style="@style/BottomNavButton"
                android:contentDescription="Add folder"
                android:src="@drawable/ic_folder_add" />

            <ImageButton
                android:id="@+id/btnAddItem"
                style="@style/BottomNavButton"
                android:contentDescription="Add item"
                android:src="@drawable/ic_add_photo" />

            <ImageButton
                android:id="@+id/btnScanCheck"
                style="@style/BottomNavButton"
                android:contentDescription="Сканировать чек"
                android:src="@android:drawable/ic_menu_agenda" />

            <ImageButton
                android:id="@+id/btnHome"
                style="@style/BottomNavButton"
                android:contentDescription="Root"
                android:src="@drawable/ic_home" />

            <ImageButton
                android:id="@+id/btnUp"
                style="@style/BottomNavButton"
                android:contentDescription="Level up"
                android:src="@drawable/ic_arrow_up" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============================================================ -->
    <!-- ПЛАШКА ПРОГРЕССА СИНХРОНИЗАЦИИ                              -->
    <!-- ============================================================ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/syncProgressCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:layout_gravity="bottom"
        app:cardCornerRadius="14dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="?attr/colorSurface"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvSyncPhaseIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    tools:text="📤" />

                <TextView
                    android:id="@+id/tvSyncPhaseText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Отправка: Хлеб «Бородинский»" />

                <TextView
                    android:id="@+id/tvSyncCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorSecondary"
                    tools:text="3 / 10" />
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/syncProgressBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:indicatorColor="@color/colorPrimary"
                app:trackColor="#E0E0E0"
                app:trackCornerRadius="3dp"
                app:trackThickness="4dp"
                app:indicatorDirectionLinear="startToEnd"
                android:max="100"
                android:progress="0" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
